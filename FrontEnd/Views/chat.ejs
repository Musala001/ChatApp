<%- include('../Partials/head', { 
  title: currentChatFriend ? `Chat with ${friends.find(f => f._id.equals(currentChatFriend))?.username}` : 'Chat',
  stylesheets: [
    '/Styles/chat.css',
    'https://cdnjs.cloudflare.com/ajax/libs/emoji-picker/1.1.5/css/emoji.min.css',
    'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'
  ],
  scripts: [
    'https://cdnjs.cloudflare.com/ajax/libs/emoji-picker/1.1.5/js/emoji-picker.min.js',
    'https://cdn.socket.io/4.5.4/socket.io.min.js',
    '/Scripts/chat.js',
    '/Scripts/voice-recorder.js'
  ]
}) %>

<%- include('../Partials/header') %>

<body>
  <div class="container">
    <div class="sidebar">
      <h2>Friends</h2>
      <ul class="friends-list">
        <% friends.forEach(friend => { %>
          <li class="<%= currentChatFriend == friend._id ? 'active' : '' %>">
            <a href="/chat/<%= friend._id %>"><%= friend.username %></a>
          </li>
        <% }) %>
      </ul>
      
    </div>

    <div class="chat-area">
      <% if (currentChatFriend) { %>
        <div id="chat-messages" class="messages">
          <% messages.forEach(msg => { %>
            <div class="message <%= msg.sender._id == currentUser._id ? 'sent' : 'received' %>">
              <p><%= msg.content %></p>
              <span><%= new Date(msg.timestamp).toLocaleTimeString() %></span>
            </div>
          <% }) %>
          <!-- Typing indicator will be injected here -->

        </div>

        <form id="message-form">
          <input type="text" id="message-input" placeholder="Type your message..." autocomplete="off">
          <button type="submit">Send</button>
        </form>
      <% } else { %>
        <div class="placeholder">
          <p>Select a friend to start chatting</p>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    const currentUserId = "<%= currentUser._id %>";
    const friendId = "<%= currentChatFriend %>";
  </script>
  <script src="https://cdn.socket.io/4.0.0/socket.io.min.js"></script>
  <script src="/Scripts/chat.js"></script>
</body>





<%- include('../Partials/footer') %>

