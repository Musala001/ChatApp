<%- include('../Partials/head', { 
  title: 'Friends',
  stylesheets: ['/Styles/friends.css'],
  isChatPage: false /* Add this line */
}) %>

<%- include('../Partials/header', { title: 'Friends' }) %>
<main>
  <section>
    <h2>Your Friends</h2>
    

    <!-- Links to other pages -->
    <nav class="main-nav">
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/directory" class="nav-button">User Directory</a>
        </li>
        <li class="nav-item">
          <a href="/chat" class="nav-button">All Chats</a>
        </li>
        <li class="nav-item">
          <a href="/posts" class="nav-button">Posts</a>
        </li>
      </ul>
    </nav>
    <ul class="friends-list">
      <% friends.forEach(friend => { %>
        <li>
          <a href="/profile/<%= friend._id %>" class="friend-username">
            <%= friend.username %>
          </a>
          <div class="friend-actions">
            <a href="/chat/<%= friend._id %>">Message</a>
            <a href="/remove-friend/<%= friend._id %>">Remove</a>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
</main>

<%- include('../Partials/footer') %>
