<%- include('../Partials/head', { 
    title: 'Edit Profile',
    stylesheets: ['/Styles/edit-profile.css'] 
  }) %>
  
  <%- include('../Partials/header', { title: 'Edit Profile' }) %>
  
  <body>

  
    <div class="edit-profile-container">
      <h1>Edit Profile</h1>
      <form action="/profile/edit/<%= currentUser._id %>" method="POST" enctype="multipart/form-data">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= currentUser.name %>" required>
      
        <label for="bio">Bio:</label>
        <textarea id="bio" name="bio"><%= currentUser.bio %></textarea>
      
        <label for="profilePic">Profile Picture:</label>
        <input type="file" id="profilePic" name="profilePic" accept="image/*">
      
        <button type="submit">Save Changes</button>
      </form>
      
      
    </div>
  </body>
  
  <%- include('../Partials/footer') %>